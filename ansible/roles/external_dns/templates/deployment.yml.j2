apiVersion: apps/v1
kind: Deployment
metadata:
  name: external-dns
  namespace: {{ external_dns_namespace }}
spec:
  replicas: 1
  strategy:
    type: Recreate
  selector:
    matchLabels:
      app: external-dns
  template:
    metadata:
      labels:
        app: external-dns
    spec:
      serviceAccountName: external-dns
      containers:
        - name: external-dns
          image: {{ external_dns_image }}
          args:
{% for source in external_dns_sources %}
            - --source={{ source }}
{% endfor %}
            - --provider=rfc2136
            - --rfc2136-host={{ external_dns_rfc2136_host }}
            - --rfc2136-port={{ external_dns_rfc2136_port }}
            - --rfc2136-zone={{ external_dns_zone }}
            - --rfc2136-tsig-keyname={{ external_dns_tsig_keyname }}
            - --rfc2136-tsig-secret-alg={{ external_dns_tsig_algorithm }}
            - --rfc2136-tsig-axfr
{% for filter in external_dns_domain_filters %}
            - --domain-filter={{ filter }}
{% endfor %}
            - --policy={{ external_dns_policy }}
            - --registry=txt
            - --txt-owner-id={{ external_dns_txt_owner_id }}
            - --interval={{ external_dns_interval }}
            - --log-level={{ external_dns_log_level }}
{% for arg in external_dns_extra_args %}
            - {{ arg }}
{% endfor %}
          env:
            - name: EXTERNAL_DNS_RFC2136_TSIG_SECRET
              valueFrom:
                secretKeyRef:
                  name: external-dns-tsig
                  key: tsig-secret
